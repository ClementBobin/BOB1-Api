# .env.example
# This is an example of a .env file. Copy this file to .env and modify the values as needed.
# JWT: the key names below are my best guess from JwtOptions in Bob1.Shared/Security.
# Check them against appsettings.json and rename if they differ.
Jwt__Issuer=https://api.your-domain.tld
Jwt__Audience=bob1-apps
# openssl rand -base64 48
Jwt__Secret=CHANGE_ME_long_random_string_at_least_32_charsZ

# PostgreSQL (used by docker-compose.yml for both the database and the API connection string)
POSTGRES_PASSWORD=CHANGE_ME_strong_database_password
